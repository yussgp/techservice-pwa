# ============================================================
# TechService PWA — referencia unificada de variables
# ============================================================
# Este archivo documenta las variables de ambos proyectos.
# En la práctica cada parte carga su propio archivo:
#   - Backend:  backend/.env   (ver backend/.env.example)
#   - Frontend: frontend/.env  (ver frontend/.env.example)
# Nunca subas archivos .env reales al repositorio.
# ============================================================

# ---------------------------- BACKEND -----------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Ruta del archivo SQLite. En producción con disco persistente usar
# una ruta absoluta, por ejemplo /var/data/techservice.sqlite.
DB_PATH=data/techservice.sqlite

# Orígenes del frontend autorizados por CORS, separados por coma.
# En producción: https://tu-frontend.vercel.app,https://tu-dominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

LOG_REQUESTS=true
APP_VERSION=1.0.0

# ---------------------------- FRONTEND ----------------------
# URL base de la API. Puede ser relativa (mismo dominio con proxy)
# o absoluta (por ejemplo https://techservice-api.onrender.com/api).
VITE_API_URL=/api

# Destino del proxy de Vite durante el desarrollo.
VITE_PROXY_TARGET=http://localhost:4000

# Activar el Service Worker en `npm run dev` (por defecto false).
# Para probar la PWA real usa `npm run build` + `npm run preview`.
VITE_ENABLE_SW=false
VITE_APP_VERSION=1.0.0
