# ============================================================
# TechService API - variables de entorno
# Copia este archivo como .env y ajusta los valores.
# ============================================================

# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto y host del servidor Express
PORT=4000
HOST=0.0.0.0

# Ruta del archivo SQLite (relativa a backend/ o absoluta).
# En producción con volumen persistente usa una ruta absoluta, por ejemplo:
# DB_PATH=/var/data/techservice.sqlite
DB_PATH=data/techservice.sqlite

# Orígenes permitidos separados por coma. Usa * solo en desarrollo.
# Añade aquí la URL de Vercel/Netlify y la de Ngrok si aplica.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Registro de peticiones en consola
LOG_REQUESTS=true

# Versión mostrada por /api/health
APP_VERSION=1.0.0
