# ============================================================
# TechService PWA - variables del frontend (Vite)
# Copia este archivo como .env para desarrollo local.
# ============================================================

# URL base de la API. Puede ser relativa (recomendado con proxy/reverse proxy)
# o absoluta (por ejemplo https://tu-api.onrender.com/api).
# Si no incluye /api, la aplicación lo añade al normalizar.
VITE_API_URL=/api

# Destino del proxy de Vite en desarrollo
VITE_PROXY_TARGET=http://localhost:4000

# Activar el Service Worker también en `npm run dev` (por defecto desactivado
# para evitar caché durante el HMR). Para probar offline usa `npm run build`
# y `npm run preview`, o activa esta variable y recarga dos veces.
VITE_ENABLE_SW=false

VITE_APP_VERSION=1.0.0
